[Unit]
Description=Private Avatar 2D game server
After=network-online.target mariadb.service tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=avatar2d
Group=avatar2d
WorkingDirectory=/opt/avatar2d/current
ExecStart=/usr/bin/java -Xms128m -Xmx512m -XX:+ExitOnOutOfMemoryError -Davatar.database.config=/etc/avatar2d/database.properties -jar server.jar
Restart=on-failure
RestartSec=15
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/avatar2d /var/log/avatar2d
MemoryMax=768M
TasksMax=256
CPUWeight=20
StandardOutput=append:/var/log/avatar2d/console.log
StandardError=append:/var/log/avatar2d/console.log

[Install]
WantedBy=multi-user.target
